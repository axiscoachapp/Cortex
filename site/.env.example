# Dados do site do Cortex. Copie para .env (ou cadastre na Vercel em
# Settings → Environment Variables) e preencha antes de publicar.
# Tudo é lido na hora do build: depois de mudar um valor, gere o site de novo.
# Campos vazios não quebram o build; o prerender lista o que falta.

# Endereço público do site, sem barra no final (decisão D22).
# Usado em canonical, Open Graph, sitemap.xml e robots.txt.
VITE_SITE_URL=

# E-mail comercial que recebe os pedidos de demonstração (D22).
VITE_SALES_EMAIL=

# WhatsApp comercial só com dígitos, no formato E.164 sem o "+" (D22).
# Exemplo de formato: 5511900000000
VITE_SALES_WHATSAPP=

# Razão social e CNPJ de quem vende o Cortex (D22).
# Aparecem no rodapé, nos termos de uso e na política de privacidade.
VITE_COMPANY_NAME=
VITE_COMPANY_CNPJ=

# E-mail do encarregado de dados (LGPD). Se ficar vazio, usa o e-mail comercial.
VITE_PRIVACY_EMAIL=

# 'true' depois da revisão jurídica: esconde a faixa "Versão preliminar"
# dos termos de uso e da política de privacidade.
VITE_LEGAL_REVIEWED=

# Preços (decisão D23). Vazios = a página mostra "Sob proposta".
# Valores em reais, só números (ex.: 4500 ou 289.90). Aparecem como "a partir de".
VITE_PRICE_IMPLEMENTATION_FROM=
VITE_PRICE_PER_DOCTOR_FROM=
# Texto curto sobre a franquia de IA (ex.: "300 consultas por médico/mês").
VITE_PRICE_AI_ALLOWANCE=
