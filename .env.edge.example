# Backend-only example. Supabase normally supplies its own URL/service credentials.
# Keep AI disabled until the separate provider/use-case review is complete.
AI_ENABLED=false
# Explicitly set to openai only for an authorized rollout/test. The saved key
# alone never enables paid inference. Never put it in a VITE_ variable.
AI_PROVIDER=disabled
OPENAI_API_KEY=
ALLOWED_ORIGIN=http://localhost:8080
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET belong only to an authorized backend.
# Never add secret keys with a VITE_ prefix.
